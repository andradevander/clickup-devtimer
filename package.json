{
  "name": "clickup-devtimer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "andradevander",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1A1720",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andradevander/clickup-devtimer.git"
  },
  "bugs": {
    "url": "https://github.com/andradevander/clickup-devtimer/issues"
  },
  "homepage": "https://github.com/andradevander/clickup-devtimer#readme",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "clickup",
    "click up",
    "time tracking",
    "time tracker",
    "timer",
    "timesheet",
    "worklog",
    "productivity",
    "task",
    "tasks",
    "idle detection",
    "status bar",
    "git branch",
    "offline",
    "project management"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "clickupDevTimer.setToken",
        "title": "%command.setToken%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.clearToken",
        "title": "%command.clearToken%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.selectWorkspace",
        "title": "%command.selectWorkspace%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.selectTask",
        "title": "%command.selectTask%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.showMenu",
        "title": "%command.showMenu%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.pauseTimer",
        "title": "%command.pauseTimer%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.resumeTimer",
        "title": "%command.resumeTimer%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.syncTime",
        "title": "%command.syncTime%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.switchTask",
        "title": "%command.switchTask%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.discardTime",
        "title": "%command.discardTime%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.openInBrowser",
        "title": "%command.openInBrowser%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.showPendingSync",
        "title": "%command.showPendingSync%",
        "category": "ClickUp DevTimer"
      },
      {
        "command": "clickupDevTimer.refreshTasks",
        "title": "%command.refreshTasks%",
        "category": "ClickUp DevTimer"
      }
    ],
    "walkthroughs": [
      {
        "id": "clickupDevTimer.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "clickupDevTimer.gettingStarted.connect",
            "title": "%walkthrough.connect.title%",
            "description": "%walkthrough.connect.description%",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:clickupDevTimer.setToken"
            ]
          },
          {
            "id": "clickupDevTimer.gettingStarted.workspace",
            "title": "%walkthrough.workspace.title%",
            "description": "%walkthrough.workspace.description%",
            "media": {
              "markdown": "media/walkthrough/workspace.md"
            },
            "completionEvents": [
              "onCommand:clickupDevTimer.selectWorkspace",
              "onSettingChanged:clickupDevTimer.teamId"
            ]
          },
          {
            "id": "clickupDevTimer.gettingStarted.track",
            "title": "%walkthrough.track.title%",
            "description": "%walkthrough.track.description%",
            "media": {
              "markdown": "media/walkthrough/track.md"
            },
            "completionEvents": [
              "onCommand:clickupDevTimer.selectTask"
            ]
          },
          {
            "id": "clickupDevTimer.gettingStarted.settings",
            "title": "%walkthrough.settings.title%",
            "description": "%walkthrough.settings.description%",
            "media": {
              "markdown": "media/walkthrough/settings.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.openSettings",
              "onSettingChanged:clickupDevTimer"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "ClickUp DevTimer",
      "properties": {
        "clickupDevTimer.teamId": {
          "type": "string",
          "default": "",
          "description": "%config.teamId%"
        },
        "clickupDevTimer.activeStatuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "in progress",
            "doing",
            "in dev"
          ],
          "description": "%config.activeStatuses%"
        },
        "clickupDevTimer.inactivityThresholdSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "description": "%config.inactivityThresholdSeconds%"
        },
        "clickupDevTimer.autoSaveIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "%config.autoSaveIntervalSeconds%"
        },
        "clickupDevTimer.minimumEntrySeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "%config.minimumEntrySeconds%"
        },
        "clickupDevTimer.roundingMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "%config.roundingMinutes%"
        },
        "clickupDevTimer.roundingMode": {
          "type": "string",
          "enum": [
            "nearest",
            "up",
            "down"
          ],
          "enumDescriptions": [
            "%config.roundingMode.nearest%",
            "%config.roundingMode.up%",
            "%config.roundingMode.down%"
          ],
          "default": "nearest",
          "description": "%config.roundingMode%"
        },
        "clickupDevTimer.askDescriptionOnFinish": {
          "type": "boolean",
          "default": true,
          "description": "%config.askDescriptionOnFinish%"
        },
        "clickupDevTimer.defaultDescription": {
          "type": "string",
          "default": "Logged via ClickUp DevTimer (VS Code)",
          "description": "%config.defaultDescription%"
        },
        "clickupDevTimer.longPauseWarningMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "%config.longPauseWarningMinutes%"
        },
        "clickupDevTimer.longSessionWarningMinutes": {
          "type": "number",
          "default": 240,
          "minimum": 0,
          "description": "%config.longSessionWarningMinutes%"
        },
        "clickupDevTimer.suggestStatusChange": {
          "type": "boolean",
          "default": true,
          "description": "%config.suggestStatusChange%"
        },
        "clickupDevTimer.branchDetection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.branchDetection.enabled%"
        },
        "clickupDevTimer.branchDetection.patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "CU-([a-z0-9]+)",
            "([A-Z][A-Z0-9]+-\\d+)"
          ],
          "description": "%config.branchDetection.patterns%"
        },
        "clickupDevTimer.recentTasksCount": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "%config.recentTasksCount%"
        },
        "clickupDevTimer.taskCacheTtlMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "%config.taskCacheTtlMinutes%"
        },
        "clickupDevTimer.syncRetryIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "%config.syncRetryIntervalMinutes%"
        },
        "clickupDevTimer.statusBar.maxTaskNameLength": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "%config.statusBar.maxTaskNameLength%"
        },
        "clickupDevTimer.weeklySummary": {
          "type": "boolean",
          "default": true,
          "description": "%config.weeklySummary%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p test/integration --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "npm run build && tsc -p test/integration",
    "test:integration": "vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "devto": "node scripts/devto.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.93.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "ovsx": "^1.3.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.3"
  }
}
